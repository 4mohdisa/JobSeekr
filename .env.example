# JobSeekr configuration.
# Copy to .env in the repo root and fill in. .env is gitignored; this file is not,
# so never put a real secret here. Every key maps to a field on backend.config.Settings;
# anything you leave out falls back to the default in that file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# local => human-readable console logs. Anything else => JSON logs.
APP_ENV=local
LOG_LEVEL=INFO
# Display and scheduling timezone. The database always stores UTC.
TIMEZONE=Australia/Adelaide
# Relative paths resolve against the working directory you launch from.
DATA_DIR=data
DATABASE_URL=sqlite:///data/app.db
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# LIVE SUBMIT MASTER SWITCH.
# false  = every apply run stops at the final submit and records a dry run.
# true   = the agent presses Submit on real job applications, for real, as you.
# Only the human user may set this to true, by hand, in their own .env.
# No agent, script, test, fixture or default may ever flip it. Leave it false.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
ALLOW_LIVE_SUBMIT=false

# ---------------------------------------------------------------------------
# LLM — keys
# Only the providers referenced by the model IDs below need a key.
#
# Every credential in this file is left EMPTY on purpose. A blank value is
# read as unset (see Settings._blank_is_unset), so nothing here can be
# mistaken for a working default — and a realistic-looking dummy is exactly
# what makes a secret scanner fire on a template that contains no secrets.
# ---------------------------------------------------------------------------
# Starts "sk-proj-" / "sk-".
OPENAI_API_KEY=
# Starts "sk-ant-api03-".
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# LLM — models (LiteLLM "<provider>/<model>" identifiers)
# These are the ONLY place model names live. Never hardcode one in code.
# ---------------------------------------------------------------------------
# Rubric scoring of the shortlist. Stage 2 is constrained classification against
# a fixed schema, which a small model does well — keep it on Flash-Lite. Moving
# this to an Opus-class model multiplies the projected spend by ~17x and breaks
# the $0.15 / 200-job target (backend/scoring/run.py::estimate_cost).
LLM_MODEL_SCORING=gemini/gemini-3.1-flash-lite
# Resume and cover letter prose.
LLM_MODEL_WRITING=anthropic/claude-opus-5
# Cheap high-volume classification (emails, job categories). Already the
# cheapest tier; if you are pushing the monthly cap, cut volume rather than
# model here.
LLM_MODEL_CLASSIFY=gemini/gemini-3.1-flash-lite
# Reading unknown application forms into a form map.
LLM_MODEL_FORMMAP=anthropic/claude-opus-5
# Embeddings for the cheap first-pass scoring of every discovered job.
LLM_MODEL_EMBEDDING=openai/text-embedding-3-small

# ---------------------------------------------------------------------------
# LLM — budget and reliability
# ---------------------------------------------------------------------------
LLM_MONTHLY_CAP_USD=25.0
# Warn once spend crosses this fraction of the cap (0.8 = 80%).
LLM_WARN_FRACTION=0.8
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# Browser (apply layer only — discovery is plain HTTP)
# ---------------------------------------------------------------------------
BROWSER_CHANNEL=chrome
# Defaults to DATA_DIR/browser_profile. Holds a live logged-in session.
BROWSER_PROFILE_DIR=data/browser_profile
# Headful on purpose: headless is a detection signal. Leave this false.
BROWSER_HEADLESS=false

# ---------------------------------------------------------------------------
# Apply pacing
# ---------------------------------------------------------------------------
# Local time, 24h. Applications are only sent inside this window.
APPLY_WINDOW_START=09:00
APPLY_WINDOW_END=17:00
# Hard floor between two submits, whatever the sampled interval says.
APPLY_MIN_INTERVAL_FLOOR_SECONDS=90
# Mean of the lognormal gap between submits.
APPLY_INTERVAL_LOGNORMAL_MEAN_SECONDS=240
# ISO date the volume ramp starts from. Blank = no warm-up ramp configured.
APPLY_WARMUP_START_DATE=

# ---------------------------------------------------------------------------
# Documents
# ---------------------------------------------------------------------------
# MiKTeX pdflatex. Not xelatex, not lualatex, not tectonic — see Claude.md.
# Windows example: C:\Users\you\AppData\Local\Programs\MiKTeX\miktex\bin\x64\pdflatex.exe
PDFLATEX_PATH=pdflatex
LATEX_PASSES=2

# ---------------------------------------------------------------------------
# Telegram (approvals, questions, alerts)
# ---------------------------------------------------------------------------
# From @BotFather. Shaped "<digits>:<35-char string>".
TELEGRAM_BOT_TOKEN=
# Your own numeric chat id — the bot answers this one chat and no other.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Gmail (inbound replies, outbound follow-ups)
# imap  => GMAIL_ADDRESS + GMAIL_APP_PASSWORD
# oauth => GMAIL_OAUTH_CLIENT_SECRET_FILE + GMAIL_OAUTH_TOKEN_FILE
# ---------------------------------------------------------------------------
GMAIL_AUTH_METHOD=imap
GMAIL_ADDRESS=
# A 16-character Google App Password, NOT your account password. Google
# disabled App Passwords for Workspace accounts in 2025 — if yours is a
# Workspace account, set GMAIL_AUTH_METHOD=oauth and leave this blank.
GMAIL_APP_PASSWORD=
GMAIL_OAUTH_CLIENT_SECRET_FILE=data/gmail_client_secret.json
GMAIL_OAUTH_TOKEN_FILE=data/gmail_token.json
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
