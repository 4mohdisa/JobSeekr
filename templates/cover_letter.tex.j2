% ---------------------------------------------------------------------------
% JobSeekr cover letter — single column, A4, pdflatex, ONE page.
% Same deliberate constraints as resume.tex.j2; see the header there.
% The parse gate enforces the one-page limit, so the AI slots are word-capped.
% ---------------------------------------------------------------------------
\documentclass[11pt,a4paper]{article}

\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{lmodern}
\usepackage[a4paper,margin=2.2cm]{geometry}
\usepackage[hidelinks]{hyperref}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.8em}

\begin{document}

% Contact details in the body, never a header — parsers skip headers.
{\large\bfseries \VAR{profile.name}}\\
\VAR{profile.email}
\BLOCK{if profile.phone} $\cdot$ \VAR{profile.phone}\BLOCK{endif}
\BLOCK{if profile.location} $\cdot$ \VAR{profile.location}\BLOCK{endif}
% \par, not a blank line. The engine renders with trim_blocks=True, which eats
% the newline that follows a block end tag — so a blank line here is consumed
% and LaTeX joins the date onto the contact paragraph. It then extracts as
% "... Adelaide SA 01 September 2026", and an ATS reads the location field as
% having a date stapled to it. \par ends the paragraph whatever the trimming
% does to the newlines around it.
% (A LaTeX comment is not a Jinja comment: naming a block tag in prose here
% would be parsed as a real tag, so they are described rather than written.)
\par
\VAR{today.long}

\BLOCK{if job.company}
Hiring Team\\
\VAR{job.company}
\BLOCK{endif}

\textbf{Re: \VAR{job.title}}

Dear Hiring Team,

\VAR{ai.opening_hook}

\VAR{ai.skills_bridge}

\VAR{ai.why_company}

\VAR{ai.closing}

Kind regards,\\
\VAR{profile.name}

\end{document}
